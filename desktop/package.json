{
  "name": "ai-memory-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "AI Memory & Context Platform \u2014 desktop agent for macOS and Windows (Phase 13)",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "npm run build && xvfb-run -a electron out/main/index.js --smoke-test",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  }
}
