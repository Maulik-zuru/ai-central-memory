<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      The minimum the hardened runtime needs for an Electron app that makes outbound HTTPS calls
      and reads files the user explicitly points it at.

      Deliberately absent: com.apple.security.device.camera, .microphone, and any
      accessibility/input-monitoring entitlement. This agent watches opted-in files and nothing
      else (Phase13 plan §3), and the entitlements file is the place that claim is enforceable
      rather than merely stated.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
  </dict>
</plist>
