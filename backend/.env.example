DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_memory_dev?schema=public"
PORT=4000
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"
CORS_ORIGIN="http://localhost:3000"

# Phase 2 (optional): without these, memory capture/embedding uses a deterministic stub provider
# (see backend/src/shared/providers/llm.provider.ts) — fine for dev/tests, not for real usage.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Optional alternative to ANTHROPIC_API_KEY: OpenRouter proxies chat completions (and embeddings)
# to many underlying models behind one key. If set, it takes precedence over ANTHROPIC_API_KEY for
# extraction/summarization/rerank/etc., and over OPENAI_API_KEY for embeddings if that's unset.
# OPENROUTER_MODEL selects the underlying model (default: anthropic/claude-3.5-haiku).
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""

# Phase 11 (US-SEC-01): in production, DATABASE_URL must require TLS for any non-loopback host —
# the process refuses to start otherwise (see src/shared/env.ts). Example:
#   DATABASE_URL="postgresql://user:pass@db.example.com:5432/ai_memory?schema=public&sslmode=require"
# At-rest encryption is an infrastructure setting on the database and object store themselves
# (e.g. RDS storage encryption, S3 SSE) — configure it there, not in application code.

# Phase 12: guards the internal /api/ops/health endpoint. Leave empty to disable the endpoint
# entirely (it 404s), which is the right setting for local development.
OPS_API_KEY=""

# Master switch for the monetization layer (default: false).
#   false / unset -> the product runs FREE. Every Pro feature is available to every account, no
#                    usage caps apply, and /api/billing/checkout|portal|webhook 404.
#   true          -> Core/Pro plans, usage caps, and the Stripe billing surface are all active.
PAYMENTS_ENABLED=false
