// AI Memory & Context Platform schema.
// Phase 1: Accounts, Auth & API Foundations — see docs/Phase1_Implementation_Plan.md §4.1.
// Phase 2: Core Memory System ("The Notebook") — see docs/Phase2_Implementation_Plan.md §5.1.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String?
  oauthGoogleId      String?  @unique
  planId             String   @default("core")
  autoCapture        Json     @default("{}") // per-platform auto-capture consent toggles (US-ACC-07)
  smartMemoryEnabled Boolean  @default(true) // Phase 4: US-ADV-01 Smart Mode toggle
  hasSeenTour        Boolean  @default(false) // Phase 12: first-run guided tour, shown once
  createdAt          DateTime @default(now())

  apiKeys       ApiKey[]
  subscription  Subscription?
  auditLogs     AuditLog[]
  sessions      Session[]
  buckets       Bucket[]
  bucketMembers BucketMember[]
  memories      Memory[]
  suggestions   MemorySuggestion[]
  categories    Category[]
  conversations Conversation[]
  monthlyInsights MonthlyInsight[]
  files         File[]
  askConversations AskConversation[]
  devicePairingCodes DevicePairingCode[]
  desktopDevices DesktopAgentDevice[]
  knowledgeGraphNodes KnowledgeGraphNode[]
  knowledgeGraphEdges KnowledgeGraphEdge[]
  usageAnalyticsEvents UsageAnalyticsEvent[]
  usageAnalyticsSummaries UsageAnalyticsSummary[]
  payments Payment[]
  dataExportRequests DataExportRequest[]
  mcpAuthorizationCodes McpAuthorizationCode[]
  mcpTokens McpToken[]
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  keyPreview String
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Subscription {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        String    @default("core") // "core" | "pro" — enforcement lands in Phase 10
  status      String    @default("trialing")
  trialEndsAt DateTime?
  stripeIds   Json?
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  targetType String?
  targetId   String?
  occurredAt DateTime @default(now())

  @@index([userId])
}

// --- Phase 2: Core Memory System ---------------------------------------------------------
// See docs/Phase2_Implementation_Plan.md §5.1 for the design rationale, including why Bucket
// is introduced here rather than in Phase 3: Memory.bucketId is never-null from its first
// migration, so Phase 3's sharing/RBAC work is additive instead of a backfill.

model Bucket {
  id        String         @id @default(cuid())
  userId    String // the creator — always also gets an "owner" BucketMember row (§6.1)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean        @default(false)
  parentId  String?
  parent    Bucket?        @relation("BucketToBucket", fields: [parentId], references: [id], onDelete: SetNull)
  children  Bucket[]       @relation("BucketToBucket")
  createdAt DateTime       @default(now())
  memories  Memory[]
  members   BucketMember[]
  invites   BucketInvite[]
  conversations Conversation[]
  files     File[]
  askConversations AskConversation[]

  @@index([userId])
  @@index([parentId])
}

// Phase 3: Buckets & Organization — see docs/Phase3_Implementation_Plan.md §6.1.
// Every bucket member — including the creator — has a row here; authorization always checks
// membership, never Bucket.userId, so there is exactly one shape for "can this user do X".
model BucketMember {
  id         String    @id @default(cuid())
  bucketId   String
  bucket     Bucket    @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String // "owner" | "editor" | "viewer"
  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@unique([bucketId, userId])
  @@index([userId])
}

model BucketInvite {
  id         String    @id @default(cuid())
  bucketId   String
  bucket     Bucket    @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  email      String
  role       String // "editor" | "viewer" — never "owner" via invite
  tokenHash  String    @unique
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([bucketId])
  @@index([email])
}

model Memory {
  id         String                       @id @default(cuid())
  userId     String
  user       User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucketId   String
  bucket     Bucket                       @relation(fields: [bucketId], references: [id])
  type       String // "text" | "image"
  content    String
  imageUrl   String?
  source     String // "manual" | "one_click" | "auto"
  status     String                       @default("active") // "active" | "stale" | "merged" | "deleted"
  embedding  Unsupported("vector(1536)")?
  categoryId String?
  category   Category?                    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt
  versions   MemoryVersion[]
  // Phase 9: knowledge graph extraction marker — same lifecycle shape as embedding/categoryId.
  graphProcessedAt DateTime?
  graphEdges KnowledgeGraphEdge[]
  // Phase 14: the absorbed side of a merge keeps a pointer to its survivor instead of losing its
  // own identity outright — status still flips to "merged" (excluded from retrieval the same way),
  // but "what happened to this fact" stays answerable. SetNull rather than Cascade: if the
  // survivor itself is later hard-deleted, the absorbed memory's row (and its version history)
  // should still exist, just pointing at nothing.
  mergedIntoId String?
  mergedInto   Memory?                     @relation("MemoryMergedInto", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Memory[]                    @relation("MemoryMergedInto")

  @@index([userId, status])
  @@index([bucketId])
  @@index([categoryId])
  @@index([mergedIntoId])
}

model MemoryVersion {
  id         String   @id @default(cuid())
  memoryId   String
  memory     Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  content    String
  changedBy  String // userId, or "system" for merges
  changeType String // "create" | "edit" | "merge"
  createdAt  DateTime @default(now())

  @@index([memoryId])
}

model MemorySuggestion {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String // "duplicate" | "stale" | "capture"
  memoryIdA    String? // null for a "capture" suggestion (draft, not yet a real Memory)
  memoryIdB    String? // null for "capture" and unused for legacy single-memory suggestions
  draftContent String? // populated only for "capture" suggestions awaiting confirmation
  status       String   @default("pending") // "pending" | "approved" | "dismissed"
  createdAt    DateTime @default(now())

  @@index([userId, status])
}

// --- Phase 4: Smart Memory & Context Retrieval Engine -------------------------------------
// See docs/Phase4_Implementation_Plan.md §5.1: categories are scoped per-account (creator), not
// per-bucket — a category is a property of content, not of organization.
model Category {
  id          String                       @id @default(cuid())
  userId      String
  user        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  centroid    Unsupported("vector(1536)")?
  memoryCount Int                          @default(0)
  createdAt   DateTime                     @default(now())
  memories    Memory[]

  @@unique([userId, label])
  @@index([userId])
}

// --- Phase 5: Chat History Archive (Import + Sync) -----------------------------------------
// See docs/Phase5_Implementation_Plan.md §5.1. Idempotency key is (bucketId, platform,
// externalId) when the export provides a platform id, else (bucketId, platform, contentHash) —
// US-ARC-02: re-importing the same export must never create a duplicate row.
model Conversation {
  id           String    @id @default(cuid())
  bucketId     String
  bucket       Bucket    @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String
  externalId   String?
  contentHash  String
  title        String
  summary      String?
  messageCount Int       @default(0)
  importedAt   DateTime  @default(now())
  lastSyncedAt DateTime  @default(now())
  status       String    @default("importing") // "importing" | "ready" | "error"
  errorReason  String?
  syncCursor   Int       @default(0)
  messages     Message[]

  @@unique([bucketId, platform, externalId])
  @@unique([bucketId, platform, contentHash])
  @@index([bucketId])
  @@index([userId])
}

model Message {
  id             String         @id @default(cuid())
  conversationId String
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  position       Int
  createdAt      DateTime
  chunks         MessageChunk[]
  // Phase 9: knowledge graph extraction marker — mirrors Memory.graphProcessedAt.
  graphProcessedAt DateTime?
  graphEdges KnowledgeGraphEdge[]
  // Phase 17 (US-ARC-07): set the moment this message's chunks are the new ~256-token,
  // light-overlap shape (chunkByTokens) rather than the old character-based one. sync.service.ts
  // sets it immediately for every newly-imported message; rechunk.service.ts's migration is what
  // backfills it — and therefore what it queries by — for messages imported before Phase 17.
  rechunkedAt DateTime?

  @@unique([conversationId, position])
  @@index([conversationId])
}

model MessageChunk {
  id        String                       @id @default(cuid())
  messageId String
  message   Message                      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  content   String
  embedding Unsupported("vector(1536)")?
  // Phase 17 (US-ARC-07): the keyword half of hybrid search — a generated column (see this
  // migration's raw SQL) kept in sync with `content` by Postgres itself, never written to from
  // application code, so it can never drift out of sync the way a manually-maintained column
  // could. `Unsupported` for the same reason `embedding` is: Prisma's schema language has no
  // tsvector type, same as it has no vector type.
  contentTsv Unsupported("tsvector")?
  createdAt DateTime                     @default(now())

  @@index([messageId])
}

model MonthlyInsight {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     String // "2026-07"
  summary   String?
  createdAt DateTime @default(now())

  @@unique([userId, month])
}

// --- Phase 6: Files & Document Knowledge Base (RAG) ----------------------------------------
// See docs/Phase6_Implementation_Plan.md §5.1. `storageKey` (not a URL) mirrors
// Memory's image-storage contract exactly, so a future StorageProvider swap needs no backfill.
model File {
  id          String      @id @default(cuid())
  bucketId    String
  bucket      Bucket      @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename    String
  mimeType    String
  sizeBytes   Int
  storageKey  String
  status      String      @default("processing") // "processing" | "ready" | "error"
  errorReason String?
  pageCount   Int?
  createdAt   DateTime    @default(now())
  chunks      FileChunk[]

  @@index([bucketId])
  @@index([userId])
}

model FileChunk {
  id        String                       @id @default(cuid())
  fileId    String
  file      File                         @relation(fields: [fileId], references: [id], onDelete: Cascade)
  page      Int
  content   String
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                     @default(now())

  @@index([fileId])
}

// --- Phase 7: The "Ask" Unified Query System ------------------------------------------------
// See docs/Phase7_Implementation_Plan.md §5.1. Deliberately separate from Phase 5's
// Conversation/Message (an *imported* read-only archive) — an AskConversation is an app-native
// thread the user has with the platform itself.
model AskConversation {
  id        String       @id @default(cuid())
  bucketId  String? // null means "asked across every bucket the user could see"
  bucket    Bucket?      @relation(fields: [bucketId], references: [id], onDelete: SetNull)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  messages  AskMessage[]

  @@index([userId])
  @@index([bucketId])
}

model AskMessage {
  id             String          @id @default(cuid())
  conversationId String
  conversation   AskConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  mode           String? // "memories" | "chat_history" | "files" | "all" — set on user turns
  citations      Json? // Citation[] — set on assistant turns, null on user turns
  position       Int
  createdAt      DateTime        @default(now())

  @@unique([conversationId, position])
  @@index([conversationId])
}

// --- Phase 8 (extension slice): pairing ------------------------------------------------------
// See docs/Phase8_BrowserExtension_Implementation_Plan.md §5.1. Short-lived, claimed once by an
// authenticated dashboard session — never issues an ApiKey directly, no special exception to
// apiKeyService.issue()'s existing "caller never sees keyHash again" rule.
//
// Phase 13 renamed this model from ExtensionPairingCode: the desktop agent pairs the exact same
// way, so one table serves both clients rather than two tables drifting apart
// (docs/Phase13_DesktopAgent_Implementation_Plan.md §6.1). @@map keeps the physical table name,
// making this a column add rather than a data move.
model DevicePairingCode {
  id           String    @id @default(cuid())
  code         String    @unique
  // Which client minted this code. status()/claim() both check it, so a desktop code presented to
  // the extension endpoint (or the reverse) is rejected rather than quietly issuing a key with
  // the wrong scope set.
  client       String    @default("extension") // "extension" | "desktop"
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consumedAt   DateTime?
  // Holds the newly-issued raw ApiKey value only transiently, between claim() (dashboard) and
  // the extension's first status() poll — the one place this system ever persists a raw key,
  // and only for the seconds it takes the extension to poll it. Cleared to null (deliveredAt
  // set) the instant it's read, so a replayed poll can never fetch it twice.
  deliveredKey String?
  deliveredAt  DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([code])
  @@map("ExtensionPairingCode")
}

// --- Phase 13: Desktop agent (macOS + Windows) -----------------------------------------------
// See docs/Phase13_DesktopAgent_Implementation_Plan.md §6.1. One row per paired machine — the
// "authenticated device channel" Backend_Plan.md §Phase 8 called for. The device is a label and a
// revocation handle; the actual authority lives in the scoped ApiKey it points at.
model DesktopAgentDevice {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String // user-visible, e.g. "Maulik's MacBook Pro"
  platform   String // "darwin" | "win32"
  osVersion  String?
  appVersion String?
  // Nullable on purpose: revoking the key directly from Settings → API Keys must leave the device
  // row intact (shown as revoked) rather than orphaning it or cascading a delete the user didn't
  // ask for.
  apiKeyId   String?   @unique
  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// --- Phase 9: Advanced Intelligence (Pro tier) ----------------------------------------------
// See docs/Phase9_Implementation_Plan.md §5.1. Entity resolution is exact-match on
// (userId, normalizedName, type) — deliberately simpler than Category's embedding-centroid
// approach, since entity names are short, low-cardinality-per-user strings.
model KnowledgeGraphNode {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  type           String // "person" | "project" | "client" | "technology" | "topic" | ...
  createdAt      DateTime             @default(now())
  edgesFrom      KnowledgeGraphEdge[] @relation("EdgeFrom")
  edgesTo        KnowledgeGraphEdge[] @relation("EdgeTo")

  @@unique([userId, normalizedName, type])
  @@index([userId])
}

model KnowledgeGraphEdge {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromNodeId String
  fromNode   KnowledgeGraphNode @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId   String
  toNode     KnowledgeGraphNode @relation("EdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  label      String
  // Attribution (US-ADV-02 AC: every edge traceable to a source) — exactly one of these is set.
  sourceMemoryId  String?
  sourceMemory    Memory?  @relation(fields: [sourceMemoryId], references: [id], onDelete: SetNull)
  sourceMessageId String?
  sourceMessage   Message? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  createdAt  DateTime           @default(now())

  @@index([userId])
  @@index([fromNodeId])
  @@index([toNodeId])
}

model UsageAnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "memory_created" | "ask_query" | "sync_completed" | "context_preview"
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, type, createdAt])
}

model UsageAnalyticsSummary {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period          String // "2026-07"
  memoriesCreated Int      @default(0)
  askQueries      Int      @default(0)
  syncsCompleted  Int      @default(0)
  tokensSaved     Int      @default(0)
  computedAt      DateTime @default(now())

  @@unique([userId, period])
}

// --- Phase 10: Billing, Plans & Monetization -------------------------------------------------
// See docs/Phase10_Implementation_Plan.md §5.1. Subscription itself needs no new columns —
// plan/status/trialEndsAt/stripeIds (Phase 1) already cover this phase's needs.
model Payment {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripePaymentId     String   @unique
  amountCents         Int
  currency            String   @default("usd")
  status              String // "succeeded" | "failed" | "refunded"
  paidAt              DateTime
  refundEligibleUntil DateTime

  @@index([userId])
}

model ProcessedWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  processedAt   DateTime @default(now())
}

// --- Phase 11: Security, Privacy & Compliance ------------------------------------------------
// See docs/Phase11_Implementation_Plan.md §5.1.
model DataExportRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String    @default("queued") // "queued" | "running" | "complete" | "failed"
  downloadKey String? // StorageProvider key for the generated archive
  errorReason String?
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  expiresAt   DateTime? // set on completion: completedAt + EXPORT_TTL

  @@index([userId])
}

// Deliberately NOT a relation to User. AuditLog cascades from User (see its onDelete above), so
// it structurally cannot hold evidence that an account was deleted — the row would vanish with
// the account it documents. This is the one table in the schema allowed to reference a user who
// no longer exists, because that is exactly the case it exists to cover (US-SEC-05).
// userEmailSnapshot is denormalized for the same reason: there is no User row left to join to.
model ComplianceLog {
  id                String    @id @default(cuid())
  userId            String
  userEmailSnapshot String
  action            String // "data.export" | "account.delete"
  requestedAt       DateTime
  completedAt       DateTime?
  outcome           String // "completed" | "failed"

  @@index([userId])
}

// --- Phase 16 (US-INT-03b): remote MCP — OAuth 2.0 + PKCE + Dynamic Client Registration --------
// See docs/MemoryPlugin_Parity_Implementation_Plan.md Phase 16 and mcp.oauth.provider.ts, which
// implements the SDK's `OAuthServerProvider` interface against these four models. No relation to
// the SDK's own types here — this is a completely ordinary OAuth authorization-server schema; the
// SDK only cares that the provider's methods return the right shapes.

// A client the SDK's Dynamic Client Registration handler creates on first connect — no relation
// to User, because a client (e.g. "Claude Desktop") is shared across every account that connects
// it, not owned by one.
model McpClient {
  id                      String    @id @default(cuid()) // == OAuth client_id
  clientSecretHash        String? // null for a public client (PKCE-only, auth method "none")
  clientName              String?
  redirectUris            String[]
  tokenEndpointAuthMethod String    @default("none")
  grantTypes              String[]  @default(["authorization_code", "refresh_token"])
  scope                   String?
  createdAt               DateTime  @default(now())
  clientSecretExpiresAt   DateTime? // null = never expires

  authorizationRequests McpAuthorizationRequest[]
  authorizationCodes    McpAuthorizationCode[]
  tokens                McpToken[]
}

// A pending authorize() call, created the moment an MCP client redirects the user's browser to
// /authorize, before we know which MemoryOS account (if any) is doing the approving — that's why
// this has no userId yet; McpAuthorizationCode is the row that gains one, once a real user
// approves via the dashboard consent screen this request id gets rendered on.
model McpAuthorizationRequest {
  id            String    @id @default(cuid())
  clientId      String
  client        McpClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  redirectUri   String
  codeChallenge String
  scopes        String[]
  state         String?
  resource      String?
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  // Set once the pending request has been turned into a code (or explicitly denied), so it can
  // never be approved a second time via a replayed link to the same consent page.
  resolvedAt    DateTime?

  @@index([clientId])
}

// Issued only after a logged-in user approves an McpAuthorizationRequest. Single-use — consumedAt
// is set the moment exchangeAuthorizationCode() succeeds, and a second exchange attempt with the
// same code is rejected (RFC 6749 §10.5's replay-prevention requirement).
model McpAuthorizationCode {
  code          String    @id @default(cuid())
  clientId      String
  client        McpClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String
  codeChallenge String
  scopes        String[]
  resource      String?
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  consumedAt    DateTime?

  @@index([clientId])
  @@index([userId])
}

// Access + refresh tokens are stored hashed (same discipline as ApiKey — Phase 1) so a database
// read alone never yields a usable credential. Refresh rotates in place (a new row is NOT created
// on refresh; the same row's accessTokenHash/refreshTokenHash/expiry are overwritten) so a stolen,
// already-rotated refresh token silently stops working the moment the legitimate client refreshes.
model McpToken {
  id                   String    @id @default(cuid())
  clientId             String
  client               McpClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenHash      String    @unique
  refreshTokenHash     String?   @unique
  scopes               String[]
  resource             String?
  accessTokenExpiresAt DateTime
  createdAt            DateTime  @default(now())
  revokedAt            DateTime?

  @@index([clientId])
  @@index([userId])
}

// Backs the `export_conversation` MCP tool specifically — deliberately NOT the same model
// `DataExportRequest` (compliance.export.service.ts) uses for whole-account exports. That flow's
// download route is ownership-gated (authenticate + requireScope) because the caller is the
// dashboard user themselves; this one is a short-lived (15-minute) capability URL an MCP client
// can hand to a human with no further auth, the same signed-URL-with-no-static-secret pattern
// image memories use — unguessable id + short TTL, not a session check, is the security boundary.
// Mixing the two into one ownership-checked model would either weaken that check or break the
// account-export flow; a second small model keeps both invariants intact.
model McpConversationExport {
  id         String   @id @default(cuid())
  downloadKey String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
