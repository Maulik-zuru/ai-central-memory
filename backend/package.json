{
  "name": "ai-memory-backend",
  "version": "0.1.0",
  "private": true,
  "description": "AI Memory & Context Platform - backend (Phase 1: Accounts, Auth & API Foundations)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
